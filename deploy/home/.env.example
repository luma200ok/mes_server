# mes_server 레포 홈서버 이전 파일럿 — deploy/home/compose.yml 용 환경변수.
# 실제 값을 채운 .env 파일은 절대 커밋하지 말 것(.gitignore 확인) — chmod 600 권장.
# 아래 값은 전부 더미/예시이며 실제 시크릿이 아니다.

# --- DB (호스트에 이미 떠 있는 db-mysql 컨테이너, mes_db 스키마 복원됨) ---
DB_USERNAME=mes_app
DB_PASSWORD=change-me

# --- Redis (호스트에 이미 떠 있는 db-redis 컨테이너) ---
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_PASSWORD=change-me

# --- JWT (HMAC-SHA256, 32바이트 이상 권장) ---
JWT_SECRET=change-me-to-a-long-random-base64-value-32bytes-min

# --- Discord 알림 웹훅 ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/change-me
